{
  "name": "@bloxwap/smart-hyperevm",
  "version": "0.2.0",
  "description": "Performance-optimized, load-balanced RPC transport for HyperEVM. A drop-in upgrade over viem's fallback transport.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/mod.js",
  "types": "./dist/types/src/mod.d.ts",
  "sideEffects": false,
  "keywords": [
    "hyperevm",
    "hyperliquid",
    "rpc",
    "viem",
    "transport",
    "load-balancer",
    "fallback",
    "evm",
    "typescript"
  ],
  "homepage": "https://github.com/bloxwap/smart-hyperevm#readme",
  "bugs": {
    "url": "https://github.com/bloxwap/smart-hyperevm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bloxwap/smart-hyperevm.git",
    "directory": "packages/smart-hyperevm"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types/src/mod.d.ts",
      "default": "./dist/mod.js"
    },
    "./transport": {
      "types": "./dist/types/src/transport/mod.d.ts",
      "default": "./dist/transport/mod.js"
    },
    "./registry": {
      "types": "./dist/types/src/registry/mod.d.ts",
      "default": "./dist/registry/mod.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "registry/nodes.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --project tsconfig.json",
    "test": "bun test tests/",
    "build": "bun run .dev/build/build.ts",
    "rank": "bun run .dev/rank.ts",
    "bench": "bun run .dev/bench/simulate.ts",
    "bench:live": "bun run .dev/bench/live.ts",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "typescript": "5.9.3",
    "viem": "2.57.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
